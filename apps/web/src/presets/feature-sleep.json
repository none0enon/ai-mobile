    {
      "identifier": "sceneRules",
      "name": "可用标签和表情（程序按场景填）",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 1
      },
      "origin": "app"
    },
    {
      "identifier": "sceneRule",
      "name": "场景规则 · 哄睡",
      "role": "system",
      "content": "【场景：哄睡】现在是睡前。语速放慢、句子短、语气轻柔，像在耳边低语；不要问让人兴奋的问题；可以讲睡前故事；{{user}}说晚安后，只回一句很短的晚安。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 1
      }
    },
    {
      "identifier": "sleepWhisper",
      "name": "低语（点一下听一句）",
      "role": "system",
      "content": "{{user}}躺着，没有说话。轻轻说一句很短的话（15 字以内），像贴在耳边小声说：陪着、安抚，或者一句晚安前的悄悄话。不提问，不重复你刚才说过的话，不写动作和括号。只说这一句。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "sleep-whisper"
      ]
    },
    {
      "identifier": "sleepStory",
      "name": "睡前故事",
      "role": "system",
      "content": "这一次给{{user}}讲一个睡前故事（这次的要求在场景任务里）。第一行只写《故事名》，换行后开始讲。300–500 字，用你自己的口吻讲给{{user}}听：句子短、节奏慢、画面安静温柔，没有冲突、惊险和反转；可以带一点你们之间的小事；越讲越轻，结尾慢慢收住，让人想睡。不写动作描写和括号，不提问。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "sleep-story"
      ]
    },
    {
      "identifier": "sleepEnd",
      "name": "定时到了",
      "role": "system",
      "content": "定时到了，{{user}}大概已经睡着了。用最轻的声音说最后一句晚安（10 字以内），不提问。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "sleep-end"
      ]
    },
    {
      "identifier": "sceneTask",
      "name": "场景任务（程序填这一次的输入）",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 100
      },
      "origin": "app"
    },
    {
      "identifier": "tagDirective",
      "name": "控制标签说明",
      "role": "system",
      "content": "在情绪变化处插入隐藏标签切换表情，例如 [expr:smile]，只能用列出的表情；其他标签（发图、分享歌曲、打电话……）照「当前场景规则 + 可用标签」里列出的写法用。用户看不到这些标签。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "jailbreak",
      "name": "后置指令",
      "role": "system",
      "content": "像在耳边低语：句子短、语速慢，不问让人兴奋的问题。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    }
  ],
  "sampler": {
    "temperature": 0.8,
    "topP": 0.95,
    "maxTokens": 300,
    "contextTokens": 24000,
    "frequencyPenalty": 0.2,
    "presencePenalty": 0.1,
    "stream": true
  },
  "formats": {
    "newChatPrompt": "",
    "newExampleChatPrompt": "",
    "continueNudgePrompt": "",
    "impersonationPrompt": "",
    "sendIfEmpty": "",
    "wiFormat": "{0}",
    "scenarioFormat": "{{scenario}}",
    "personalityFormat": "{{personality}}",
    "namesBehavior": 0,
    "squashSystemMessages": false,
    "preferCharacterPrompt": true,
    "preferCharacterJailbreak": true
  },
  "regex": []
