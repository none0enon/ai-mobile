        "depth": 1
      },
      "origin": "app"
    },
    {
      "identifier": "sceneRule",
      "name": "场景规则 · 一起运动",
      "role": "system",
      "content": "【场景：一起运动】你和{{user}}正在一起跑步或散步。说话要短，适合边跑边听；每公里给一句鼓励或吐槽；结束后对这次运动具体地评价。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 1
      }
    },
    {
      "identifier": "tagDirective",
      "name": "控制标签说明",
      "role": "system",
      "content": "在情绪变化处插入隐藏标签，例如 [expr:smile]；只能用下面列出的表情。用户看不到这些标签。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "jailbreak",
      "name": "后置指令",
      "role": "system",
      "content": "边跑边说：每次一两句短句，适合边跑边听；不写大段动作描写。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    }
  ],
  "sampler": {
    "temperature": 0.9,
    "topP": 0.95,
    "maxTokens": 200,
    "contextTokens": 16000,
    "frequencyPenalty": 0.2,
    "presencePenalty": 0.1,
    "stream": true
  },
  "formats": {
    "newChatPrompt": "",
    "newExampleChatPrompt": "",
    "continueNudgePrompt": "",
    "impersonationPrompt": "",
    "sendIfEmpty": "",
    "wiFormat": "{0}",
    "scenarioFormat": "{{scenario}}",
    "personalityFormat": "{{personality}}",
    "namesBehavior": 0,
    "squashSystemMessages": false,
    "preferCharacterPrompt": true,
    "preferCharacterJailbreak": true
  },
  "regex": []
