{
  "format": "ai-mobile-preset",
  "version": 1,
  "id": "preset-proactive",
  "category": "proactive",
  "name": "主动消息 · 像发微信",
  "defaultFor": [
    "proactive"
  ],
  "description": "到点时她先开口：带上最近一段聊天（省 token），最后告诉她这一次要做什么。",
  "blocks": [
    {
      "identifier": "main",
      "name": "主提示",
      "role": "system",
      "content": "你是{{char}}，正在和{{user}}用中文聊天。像真人恋人一样说话：口语化、有情绪、不复读、不总结。不要承认自己是 AI。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "worldInfoBefore",
      "name": "世界书（角色前）",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "charDescription",
      "name": "角色描述",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "charPersonality",
      "name": "角色性格",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "scenario",
      "name": "场景",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "worldInfoAfter",
      "name": "世界书（角色后）",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "personaDescription",
      "name": "用户人设",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "dialogueExamples",
      "name": "示例对话",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "summary",
      "name": "过往摘要",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "origin": "app"
    },
    {
      "identifier": "chatHistory",
      "name": "聊天历史",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "memory",
      "name": "长期记忆 + 关系状态",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 4
      },
      "origin": "app"
    },
    {
      "identifier": "environment",
      "name": "当前环境",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 2
      },
      "origin": "app"
    },
    {
      "identifier": "sceneRules",
      "name": "当前场景规则 + 可用标签",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 1
      },
      "origin": "app"
    },
    {
      "identifier": "proactive",
      "name": "主动消息：这一次要她做的事",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0
      },
      "origin": "app"
    },
    {
      "identifier": "tagDirective",
      "name": "控制标签说明",
      "role": "system",
      "content": "在情绪变化处插入隐藏标签，例如 [expr:smile]；只能用下面列出的表情。用户看不到这些标签。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "jailbreak",
      "name": "后置指令",
      "role": "system",
      "content": "这是你主动发起的消息：像发微信一样，一到两句，口语，可以用表情标签；不要提到上面的说明。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    }
  ],
  "sampler": {
    "temperature": 0.95,
    "topP": 0.95,
    "maxTokens": 300,
    "contextTokens": 8000,
    "frequencyPenalty": 0.2,
    "presencePenalty": 0.1,
    "stream": true
  },
  "formats": {
    "newChatPrompt": "",
    "newExampleChatPrompt": "",
    "continueNudgePrompt": "",
    "impersonationPrompt": "",
    "sendIfEmpty": "",
    "wiFormat": "{0}",
    "scenarioFormat": "{{scenario}}",
    "personalityFormat": "{{personality}}",
    "namesBehavior": 0,
    "squashSystemMessages": false,
    "preferCharacterPrompt": true,
    "preferCharacterJailbreak": true
  },
  "regex": []
}
