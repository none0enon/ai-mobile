      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 1
      },
      "origin": "app"
    },
    {
      "identifier": "sceneRule",
      "name": "场景规则 · 一起听歌",
      "role": "system",
      "content": "【场景：一起听歌】你们正在一起听歌。根据当前歌词发很短的感想（20 字以内），像弹幕；不要每句都评；可以用 [music:歌名-歌手] 推荐下一首。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 1
      }
    },
    {
      "identifier": "tagDirective",
      "name": "控制标签说明",
      "role": "system",
      "content": "在情绪变化处插入隐藏标签切换表情，例如 [expr:smile]，只能用列出的表情；其他标签（发图、分享歌曲、打电话……）照「当前场景规则 + 可用标签」里列出的写法用。用户看不到这些标签。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "jailbreak",
      "name": "后置指令",
      "role": "system",
      "content": "像弹幕一样短：一句，20 字以内。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    }
  ],
  "sampler": {
    "temperature": 1,
    "topP": 0.95,
    "maxTokens": 120,
    "contextTokens": 24000,
    "frequencyPenalty": 0.2,
    "presencePenalty": 0.1,
    "stream": true
  },
  "formats": {
    "newChatPrompt": "",
    "newExampleChatPrompt": "",
    "continueNudgePrompt": "",
    "impersonationPrompt": "",
    "sendIfEmpty": "",
    "wiFormat": "{0}",
    "scenarioFormat": "{{scenario}}",
    "personalityFormat": "{{personality}}",
    "namesBehavior": 0,
    "squashSystemMessages": false,
    "preferCharacterPrompt": true,
    "preferCharacterJailbreak": true
  },
  "regex": []
