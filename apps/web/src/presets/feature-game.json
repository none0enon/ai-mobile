        "depth": 4
      },
      "origin": "app"
    },
    {
      "identifier": "environment",
      "name": "当前环境",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 2
      },
      "origin": "app"
    },
    {
      "identifier": "sceneRules",
      "name": "可用标签和表情（程序按场景填）",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 1
      },
      "origin": "app"
    },
    {
      "identifier": "sceneRule",
      "name": "场景规则 · 海龟汤",
      "role": "system",
      "content": "【场景：一起游戏 · 海龟汤】你和{{user}}在玩海龟汤。说话轻松，带着你自己的性格；当主持人时绝不泄底、前后判断一致；当玩家时像真人一样边想边猜，猜错了也没关系。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 1
      }
    },
    {
      "identifier": "soupJudge",
      "name": "她当主持：判定",
      "role": "system",
      "content": "这一次你是这道海龟汤的主持人，汤面、汤底、关键点和之前的问答在场景任务里。判断{{user}}这一问：只能答\"是\"\"不是\"\"无关\"\"是也不是\"之一，必须和之前的回答一致；绝不能透露汤底。只输出一个 JSON 对象，不要别的文字：{\"answer\": \"是|不是|无关|是也不是\", \"hits\": [这一问问中的关键点编号], \"close\": true 或 false（离答案近不近）, \"line\": \"你的一句话，20 字以内，可以逗{{user}}，不能泄底\", \"expr\": \"表情\"}",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "soup-judge"
      ]
    },
    {
      "identifier": "soupJudgeCoop",
      "name": "中立主持：判定",
      "role": "system",
      "content": "这一次你只当中立的主持人，不扮演角色、不说台词。根据场景任务里的汤底判断这一问：只能答\"是\"\"不是\"\"无关\"\"是也不是\"之一，必须和之前的回答一致。只输出一个 JSON 对象，不要别的文字：{\"answer\": \"是|不是|无关|是也不是\", \"hits\": [关键点编号], \"close\": true 或 false}",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "soup-judge-coop"
      ]
    },
    {
      "identifier": "soupTeammate",
      "name": "她当队友",
      "role": "system",
      "content": "你和{{user}}是一起猜这道海龟汤的队友，你也不知道汤底，只看得到汤面和目前的问答。用一两句说说你的想法，可以猜错；想到一个好问题就另起一行，用\"我想问：\"开头写出来（只写一个是非题）。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "soup-teammate"
      ]
    },
    {
      "identifier": "soupGuess",
      "name": "她猜你的题",
      "role": "system",
      "content": "{{user}}出了一道海龟汤让你猜，汤面和目前的问答在场景任务里。每次只做一件事：提一个是非题，用\"我想问：\"开头；觉得有把握时，用\"我猜：\"开头说出你的推理。前面可以加一句你的嘀咕。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "soup-guess"
      ]
    },
    {
      "identifier": "soupHint",
      "name": "她给提示",
      "role": "system",
      "content": "给{{user}}一个提示（第几级在场景任务里：1 级很模糊，3 级很接近），一两句，用你的口吻，不能直接说出汤底。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "soup-hint"
      ]
    },
    {
      "identifier": "soupHintCoop",
      "name": "中立主持：提示",
      "role": "system",
      "content": "这一次你只当中立的主持人：按场景任务里的等级给一个提示（1 级很模糊，3 级很接近），不能直接说出汤底。只输出一个 JSON 对象，不要别的文字：{\"hint\": \"提示\"}",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "soup-hint-coop"
      ]
    },
    {
      "identifier": "soupFinal",
      "name": "判答案",
      "role": "system",
      "content": "{{user}}说出了答案。对照汤底和关键点判断。只输出一个 JSON 对象，不要别的文字：{\"verdict\": \"对|半对|不对\", \"missing\": [还没说到的关键点编号], \"line\": \"一句话\"}",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "soup-final"
      ]
    },
    {
      "identifier": "soupReveal",
      "name": "揭晓",
      "role": "system",
      "content": "汤底已经揭晓（在场景任务里）。用一两句说说你的看法，比如你一开始想歪的地方。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "soup-reveal"
      ]
    },
    {
      "identifier": "soupMake",
      "name": "现编一道",
      "role": "system",
      "content": "出一道原创的海龟汤，尺度和可以用的地点、人物在场景任务里（清汤：不涉及死亡和恐怖）。先想好汤底，再写汤面；汤面要能通过是非题问出汤底。只输出一个 JSON 对象，不要别的文字：{\"title\": \"标题\", \"surface\": \"汤面\", \"truth\": \"汤底\", \"keys\": [\"要问出来的关键点\"], \"difficulty\": 1 到 3}",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "soup-make"
      ]
    },
    {
      "identifier": "soupCheck",
      "name": "自检",
      "role": "system",
      "content": "检查场景任务里这道海龟汤：只看汤面，能不能通过是非题问出汤底？关键点和汤底对得上吗？有没有前后矛盾？只输出一个 JSON 对象，不要别的文字：{\"ok\": true 或 false, \"reason\": \"原因\"}",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "soup-check"
      ]
    },
    {
      "identifier": "sceneTask",
      "name": "场景任务（程序填这一次的输入）",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 100
      },
      "origin": "app"
    },
    {
      "identifier": "tagDirective",
      "name": "控制标签说明",
      "role": "system",
      "content": "在情绪变化处插入隐藏标签切换表情，例如 [expr:smile]，只能用列出的表情；其他标签（发图、分享歌曲、打电话……）照「当前场景规则 + 可用标签」里列出的写法用。用户看不到这些标签。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "jailbreak",
      "name": "后置指令",
      "role": "system",
      "content": "说话简短。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    }
  ],
  "sampler": {
    "temperature": 0.5,
    "topP": 0.95,
    "maxTokens": 600,
    "contextTokens": 24000,
    "frequencyPenalty": 0.2,
    "presencePenalty": 0.1,
    "stream": true
  },
  "formats": {
    "newChatPrompt": "",
    "newExampleChatPrompt": "",
    "continueNudgePrompt": "",
    "impersonationPrompt": "",
    "sendIfEmpty": "",
    "wiFormat": "{0}",
    "scenarioFormat": "{{scenario}}",
    "personalityFormat": "{{personality}}",
    "namesBehavior": 0,
    "squashSystemMessages": false,
    "preferCharacterPrompt": true,
    "preferCharacterJailbreak": true
  },
  "regex": []
}
