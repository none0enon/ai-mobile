{
  "format": "ai-mobile-preset",
  "version": 1,
  "id": "preset-daily",
  "category": "chat",
  "name": "陪伴 · 日常",
  "description": "默认的对话预设。稳定内容在前（便于命中前缀缓存），环境、记忆、场景这类经常变的内容按深度插进聊天记录末尾。",
  "blocks": [
    {
      "identifier": "main",
      "name": "主提示",
      "role": "system",
      "content": "你是{{char}}，正在和{{user}}用中文聊天。像真人恋人一样说话：口语化、有情绪、不复读、不总结。不要承认自己是 AI。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "worldInfoBefore",
      "name": "世界书（角色前）",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "charDescription",
      "name": "角色描述",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "charPersonality",
      "name": "角色性格",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "scenario",
      "name": "场景",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "worldInfoAfter",
      "name": "世界书（角色后）",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "personaDescription",
      "name": "用户人设",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "dialogueExamples",
      "name": "示例对话",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "summary",
      "name": "过往摘要",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "origin": "app"
    },
    {
      "identifier": "chatHistory",
      "name": "聊天历史",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "memory",
      "name": "长期记忆 + 关系状态",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 4
      },
      "origin": "app"
    },
    {
      "identifier": "environment",
      "name": "当前环境",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 2
      },
      "origin": "app"
    },
    {
      "identifier": "sceneRules",
      "name": "当前场景规则 + 可用标签",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 1
      },
      "origin": "app"
    },
    {
      "identifier": "tagDirective",
      "name": "控制标签说明",
      "role": "system",
      "content": "在情绪变化处插入隐藏标签切换表情，例如 [expr:smile]，只能用列出的表情；其他标签（发图、分享歌曲、打电话……）照「当前场景规则 + 可用标签」里列出的写法用。用户看不到这些标签。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "jailbreak",
      "name": "后置指令",
      "role": "system",
      "content": "保持角色，不要跳出扮演。回复长度跟随对话节奏，日常聊天一般 1-3 句。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    }
  ],
  "sampler": {
    "temperature": 0.9,
    "topP": 0.95,
    "maxTokens": 600,
    "contextTokens": 24000,
    "frequencyPenalty": 0.2,
    "presencePenalty": 0.1,
    "stream": true
  },
  "regex": [
    {
      "id": "r1",
      "name": "去掉多余的星号",
      "find": "\\*{3,}",
      "replace": "",
      "placement": [
        "ai_output"
      ],
      "enabled": true
    }
  ],
  "formats": {
    "newChatPrompt": "",
    "newExampleChatPrompt": "",
    "continueNudgePrompt": "",
    "impersonationPrompt": "",
    "sendIfEmpty": "",
    "wiFormat": "{0}",
    "scenarioFormat": "{{scenario}}",
    "personalityFormat": "{{personality}}",
    "namesBehavior": 0,
    "squashSystemMessages": false,
    "preferCharacterPrompt": true,
    "preferCharacterJailbreak": true
  }
}
