{
  "format": "ai-mobile-preset",
  "version": 1,
  "id": "preset-scene-study",
  "category": "feature",
  "name": "陪伴学习",
  "defaultFor": [
    "scene:study"
  ],
  "description": "陪伴学习时用：轻声、简短，不打扰专注。场景规则在\"场景规则\"那一块里，可以改；能用的标签和表情由程序按场景填。",
  "blocks": [
