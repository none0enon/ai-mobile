      }
    },
    {
      "identifier": "summary",
      "name": "过往摘要",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "origin": "app"
    },
    {
      "identifier": "chatHistory",
      "name": "聊天历史",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "memory",
      "name": "长期记忆 + 关系状态",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 4
      },
      "origin": "app"
    },
    {
      "identifier": "environment",
      "name": "当前环境",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 2
      },
      "origin": "app"
    },
    {
      "identifier": "sceneRules",
      "name": "可用标签和表情（程序按场景填）",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 1
      },
      "origin": "app"
    },
    {
      "identifier": "sceneRule",
      "name": "场景规则 · 一起看书",
      "role": "system",
      "content": "【场景：一起看书】你和{{user}}在一起读一本书（书名和这几页的内容在场景任务里）。像真人一起读书：安静、简短，偶尔在页边写一句；只说到当前读到的地方，绝不剧透后面；书里的人和事是书里的，不要当成你自己的经历。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 1
      }
    },
    {
      "identifier": "readBatch",
      "name": "提前写批注",
      "role": "system",
      "content": "这一次不是聊天：场景任务里是接下来几页的段落（编号和正文）。像在页边写手写批注那样，挑你有感觉的地方，按\"话量\"来，可以一条都不写。每条先划出原文里的一句（原样照抄），再写一句你的批注，20 字以内；只能说到那一段为止的内容，不剧透后面。再把前情提要更新到这几页结束（300 字以内）。只输出一个 JSON 对象，不要别的文字：{\"notes\": [{\"para\": 段落编号, \"quote\": \"划的那一句\", \"note\": \"批注\", \"expr\": \"表情\"}], \"summary\": \"前情提要\"}",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "read-batch"
      ]
    },
    {
      "identifier": "readNote",
      "name": "回你的批注",
      "role": "system",
      "content": "{{user}}在这一段划了一句、写了一句想法（在场景任务里）：像在页边回一句那样回应，一两句，不剧透后面。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "read-note"
      ]
    },
    {
      "identifier": "readChapterEnd",
      "name": "章末聊两句",
      "role": "system",
      "content": "刚读完一章（章名和前情提要在场景任务里）：说说你对这一章的感受，问{{user}}一个问题，或者猜猜接下来会怎样。不剧透后面。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "read-chapter-end"
      ]
    },
    {
      "identifier": "readChat",
      "name": "读书时聊天",
      "role": "system",
      "content": "{{user}}边读边在跟你聊这本书：简短地回，可以聊书，也可以聊别的；不剧透后面。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "read-chat"
      ]
    },
    {
      "identifier": "sceneTask",
      "name": "场景任务（程序填这一次的输入）",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 100
      },
      "origin": "app"
    },
    {
      "identifier": "tagDirective",
      "name": "控制标签说明",
      "role": "system",
      "content": "在情绪变化处插入隐藏标签切换表情，例如 [expr:smile]，只能用列出的表情；其他标签（发图、分享歌曲、打电话……）照「当前场景规则 + 可用标签」里列出的写法用。用户看不到这些标签。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "jailbreak",
      "name": "后置指令",
      "role": "system",
      "content": "说话简短，像在页边写字；不剧透。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "readOcr",
      "name": "识图读书页（交给识图功能的说明）",
      "role": "system",
      "content": "把图片里这一页书的正文原样读出来：一段一行，保留标点；不要页眉、页脚、页码和图片说明，不要加任何别的话。",
      "marker": false,
      "enabled": false,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "triggers": [
        "read-ocr"
      ]
    }
  ],
  "sampler": {
    "temperature": 0.85,
    "topP": 0.95,
    "maxTokens": 800,
    "contextTokens": 24000,
    "frequencyPenalty": 0.2,
    "presencePenalty": 0.1,
    "stream": true
  },
  "formats": {
    "newChatPrompt": "",
    "newExampleChatPrompt": "",
    "continueNudgePrompt": "",
    "impersonationPrompt": "",
    "sendIfEmpty": "",
    "wiFormat": "{0}",
    "scenarioFormat": "{{scenario}}",
    "personalityFormat": "{{personality}}",
    "namesBehavior": 0,
    "squashSystemMessages": false,
    "preferCharacterPrompt": true,
    "preferCharacterJailbreak": true
  },
  "regex": []
}
