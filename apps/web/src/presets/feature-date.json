{
  "format": "ai-mobile-preset",
  "version": 1,
  "id": "preset-scene-date",
  "category": "feature",
  "name": "约会",
  "defaultFor": [
    "scene:date"
  ],
  "description": "约会时用：旁白 + 台词 + 选项，像视觉小说。场景规则在\"场景规则\"那一块里，可以改；能用的标签和表情由程序按场景填。",
  "blocks": [
