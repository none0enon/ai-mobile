    },
    {
      "identifier": "exprAngry",
      "name": "表情 · 愤怒",
      "role": "system",
      "content": "angry, frown, v-shaped eyebrows, clenched teeth, glaring",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "triggers": [
        "sprite-expr:愤怒"
      ],
      "extra": {
        "emotion": "angry",
        "hint": "生气、被惹恼时"
      }
    },
    {
      "identifier": "exprSad",
      "name": "表情 · 悲伤",
      "role": "system",
      "content": "sad, frown, downturned eyes, teary eyes, closed mouth",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "triggers": [
        "sprite-expr:悲伤"
      ],
      "extra": {
        "emotion": "sad",
        "hint": "难过、失落、委屈时"
      }
    },
    {
      "identifier": "exprSurprised",
      "name": "表情 · 惊讶",
      "role": "system",
      "content": "surprised, open mouth, wide-eyed, raised eyebrows, :o",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "triggers": [
        "sprite-expr:惊讶"
      ],
      "extra": {
        "emotion": "surprised",
        "hint": "吃惊、没想到时"
      }
    },
    {
      "identifier": "exprDisgust",
      "name": "表情 · 嫌弃",
      "role": "system",
      "content": "disgust, frown, half-closed eyes, wavy mouth",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "triggers": [
        "sprite-expr:嫌弃"
      ],
      "extra": {
        "emotion": "disgusted",
        "hint": "看不惯、嫌弃你时（没刷牙、没洗澡……）"
      }
    },
    {
      "identifier": "exprSmile",
      "name": "表情 · 微笑",
      "role": "system",
      "content": "smile, closed mouth, happy",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "triggers": [
        "sprite-expr:微笑"
      ],
      "extra": {
        "emotion": "happy",
        "hint": "开心、温柔、打招呼时"
      }
    },
    {
      "identifier": "exprSleep",
      "name": "表情 · 睡着",
      "role": "system",
