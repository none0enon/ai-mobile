  ],
  "sampler": {
    "temperature": 0.7,
    "topP": 1,
    "maxTokens": 1200,
    "contextTokens": 32000,
    "frequencyPenalty": 0,
    "presencePenalty": 0,
    "stream": false
  },
  "extra": {
