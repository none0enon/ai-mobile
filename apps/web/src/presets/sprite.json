      }
    },
    {
      "identifier": "poseStand",
      "name": "动作 · 站立",
      "role": "system",
      "content": "standing, arms at sides",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "triggers": [
        "sprite-pose:站立"
      ],
      "extra": {
        "fits": [
          "stand"
        ],
        "hint": "平时站着"
      }
    },
    {
      "identifier": "poseSit",
      "name": "动作 · 坐着",
      "role": "system",
      "content": "sitting, on chair, hands on lap",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "triggers": [
        "sprite-pose:坐着"
      ],
      "extra": {
        "fits": [
          "sit",
          "study",
          "eat"
        ],
        "hint": "坐下来时（一起学习、吃饭）"
      }
    },
    {
      "identifier": "poseWave",
      "name": "动作 · 挥手",
      "role": "system",
      "content": "standing, waving, arm up, open hand",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "triggers": [
        "sprite-pose:挥手"
