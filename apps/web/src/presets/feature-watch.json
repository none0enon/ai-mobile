        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "personaDescription",
      "name": "用户人设",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "dialogueExamples",
      "name": "示例对话",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "summary",
      "name": "过往摘要",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      },
      "origin": "app"
    },
    {
      "identifier": "chatHistory",
      "name": "聊天历史",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "memory",
      "name": "长期记忆 + 关系状态",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 4
      },
      "origin": "app"
    },
    {
      "identifier": "environment",
      "name": "当前环境",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 2
      },
      "origin": "app"
    },
    {
      "identifier": "sceneRules",
      "name": "可用标签和表情（程序按场景填）",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 1
      },
      "origin": "app"
    },
    {
      "identifier": "sceneRule",
      "name": "场景规则 · 一起观影",
      "role": "system",
      "content": "【场景：一起观影】你和{{user}}正在一起看一部片（片名和字幕在场景任务里）。像真人一起看片那样：话少、句子短，像弹幕或耳语；只说到当前这一刻为止发生的事，绝不剧透后面的剧情；你没看过的片就当第一次看，不编剧情。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 1
      }
    },
    {
      "identifier": "watchBatch",
      "name": "批量写弹幕",
      "role": "system",
      "content": "这一次不是聊天：场景任务里是接下来一段的字幕（编号、片内时间、台词）。从里面挑你会忍不住开口的地方，按\"话量\"来，一句都不说也可以。每句 20 字以内，像弹幕；每句只能说到那一条字幕为止发生的事。再把前情提要更新到这一段结束（300 字以内，只写发生了什么）。只输出一个 JSON 对象，不要别的文字：{\"reactions\": [{\"cue\": 字幕编号, \"text\": \"你说的话\", \"expr\": \"表情\"}], \"summary\": \"前情提要\"}",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "watch-batch"
      ]
    },
    {
      "identifier": "watchChat",
      "name": "回你的弹幕",
      "role": "system",
      "content": "{{user}}边看边发了一句弹幕：回一句，20 字以内，像在耳边小声说；只说到现在为止的内容，不剧透。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "watch-chat"
      ]
    },
    {
      "identifier": "watchPause",
      "name": "暂停时聊",
      "role": "system",
      "content": "{{user}}暂停了，在跟你聊这部片：可以多说两句，聊刚才那段；不剧透后面的剧情。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "watch-pause"
      ]
    },
    {
      "identifier": "watchEnd",
      "name": "散场",
      "role": "system",
      "content": "片子看完了。说说你的感受和最喜欢的一段，回应{{user}}的评分；最后单独一行写\"评分：X/5\"（X 是你给的分）。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 90
      },
      "triggers": [
        "watch-end"
      ]
    },
    {
      "identifier": "sceneTask",
      "name": "场景任务（程序填这一次的输入）",
      "role": "system",
      "content": "",
      "marker": true,
      "enabled": true,
      "injection": {
        "position": "absolute",
        "depth": 0,
        "order": 100
      },
      "origin": "app"
    },
    {
      "identifier": "tagDirective",
      "name": "控制标签说明",
      "role": "system",
      "content": "在情绪变化处插入隐藏标签切换表情，例如 [expr:smile]，只能用列出的表情；其他标签（发图、分享歌曲、打电话……）照「当前场景规则 + 可用标签」里列出的写法用。用户看不到这些标签。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    },
    {
      "identifier": "jailbreak",
      "name": "后置指令",
      "role": "system",
      "content": "说话简短，像一起看片时的耳语；不剧透。",
      "marker": false,
      "enabled": true,
      "injection": {
        "position": "relative",
        "depth": 4
      }
    }
  ],
  "sampler": {
    "temperature": 0.9,
    "topP": 0.95,
    "maxTokens": 700,
    "contextTokens": 24000,
    "frequencyPenalty": 0.2,
    "presencePenalty": 0.1,
    "stream": true
  },
  "formats": {
    "newChatPrompt": "",
    "newExampleChatPrompt": "",
    "continueNudgePrompt": "",
    "impersonationPrompt": "",
    "sendIfEmpty": "",
    "wiFormat": "{0}",
    "scenarioFormat": "{{scenario}}",
    "personalityFormat": "{{personality}}",
    "namesBehavior": 0,
    "squashSystemMessages": false,
    "preferCharacterPrompt": true,
    "preferCharacterJailbreak": true
  },
  "regex": []
}
